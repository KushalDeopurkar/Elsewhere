# Copy to .env.local. Everything is optional except BACKEND_URL; features
# whose keys are missing switch themselves off and say so in the UI.

# API (the FastAPI backend in ../backend)
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Accounts, friends, lists, polls (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SOCIAL_SAMPLES=

# Search by meaning, similar events and the day planner
GEMINI_API_KEY=
GROQ_API_KEY=
PLANNER_API_KEY=
PLANNER_BASE_URL=
PLANNER_MODEL=
SEMANTIC_MIN_SIMILARITY=

# Map tiles (a MapLibre style URL) and travel times
NEXT_PUBLIC_MAP_STYLE=
NEXT_PUBLIC_MAP_STYLE_FALLBACK=
GOOGLE_MAPS_API_KEY=
GOOGLE_ROUTES_API_BASE=
TOMTOM_API_KEY=
TOMTOM_API_BASE=

# Posters through an image proxy (for example https://wsrv.nl)
NEXT_PUBLIC_IMAGE_PROXY=

# Reminders (web push)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
PUSH_TEST_HOSTS=

# Alerts by email (Brevo) and Telegram
BREVO_API_KEY=
BREVO_API_BASE=
ALERT_EMAIL_FROM=
ALERT_MIN_SIMILARITY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=

# Operator details shown on the legal pages
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=

# Error tracking and search console
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
GOOGLE_SITE_VERIFICATION=
